<Window x:Class="ShioriCSharp.CharVisualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="立绘变更 - 控制面板"
        Height="520" Width="900"
        MinHeight="300" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow"
        Closing="OnClosing">
    <Window.Resources>
        <!-- 自定义 ListBoxItem 样式：选中项灰色背景，无蓝框 -->
        <Style x:Key="NoBlueSelection" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Name="Bd" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" 
                                SnapsToDevicePixels="true">
                            <ContentPresenter 
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE0E0E0"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFAAAAAA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- 顶部：比例设置 + 打开预览按钮 + 刷新配置 -->
        <Border DockPanel.Dock="Top" Background="#f0f0f0" Padding="8,6" BorderBrush="#ccc" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="预览比例：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Grid.Column="1" Name="cmbAspectRatio" Width="80" SelectionChanged="OnAspectRatioChanged">
                    <ComboBoxItem Content="16:9" Tag="1.77777777777778"/>
                    <ComboBoxItem Content="4:3" Tag="1.33333333333333"/>
                </ComboBox>
                
                <TextBlock Grid.Column="2" Text="  |  " VerticalAlignment="Center" Foreground="#999" Margin="5,0"/>
                
                <Button Grid.Column="3" Name="btnRefresh" Content="刷新配置" Width="80" Height="26" Margin="0,0,8,0" Click="OnRefreshClick"/>
                
                <TextBlock Grid.Column="4" Name="txtStatus" Text="" VerticalAlignment="Center" Foreground="#666"/>
                
                <!-- 按钮组 -->
                <Button Grid.Column="5" Name="btnOpenPreview" Content="打开立绘预览" Width="110" Height="26" Click="OnOpenPreviewClick"/>
                <Button Grid.Column="6" Name="btnPreview" Content="预览立绘指令" Width="110" Height="26" Margin="5,0,0,0" Click="OnPreviewClick"/>
                <Button Grid.Column="7" Name="btnCopy" Content="复制完整指令" Width="110" Height="26" Margin="5,0,0,0" Click="OnCopyClick"/>
            </Grid>
        </Border>

        <!-- 底部说明区 -->
        <Border DockPanel.Dock="Bottom" Background="#f8f8f8" Padding="8,6" BorderBrush="#ccc" BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock Text="说明：" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox Name="txtNotes" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True" 
                         MinHeight="60" 
                         MaxHeight="200" 
                         VerticalScrollBarVisibility="Auto"
                         Text="1.旧版立绘由于设计较为简单，没有脸部差分等详细信息，因此在这里不做展示，请直接在剧本的chars元素中按照以前的方式使用&#10;
2.新版立绘的脸部差分信息会被自动解析为默认状态，复制出来的差分没有动作等修饰词，请自行到剧本的chars元素中补充&#10;"/>
            </StackPanel>
        </Border>

        <!-- 主区域：TabControl（填充剩余空间） -->
        <TabControl Margin="4,4,4,4" Name="tabMain">
            <TabItem Header="立绘" IsSelected="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 角色 -->
                    <GroupBox Grid.Row="0" Grid.Column="0" Header="角色" Margin="0,0,2,0">
                        <ListBox Name="lstChar" SelectionMode="Single" SelectionChanged="OnCharSelectionChanged"/>
                    </GroupBox>

                    <!-- 位置层级 - 拆为X轴(水平)和Y轴(垂直)两个独立列表 -->
                    <GroupBox Grid.Row="0" Grid.Column="1" Header="位置层级" Margin="2,0,2,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- X轴：水平位置 -->
                            <TextBlock Grid.Row="0" Text="水平 (X)" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,2"/>
                            <ListBox Grid.Row="1" Name="lstPosX" SelectionMode="Single"
                                     SelectionChanged="OnPosXSelectionChanged"
                                     PreviewMouseLeftButtonDown="OnPosXPreviewMouseDown"
                                     MaxHeight="140">
                                <ListBoxItem Content="左左"/>
                                <ListBoxItem Content="左"/>
                                <ListBoxItem Content="左右"/>
                                <ListBoxItem Content="中"/>
                                <ListBoxItem Content="右左"/>
                                <ListBoxItem Content="右"/>
                                <ListBoxItem Content="右右"/>
                            </ListBox>

                            <!-- Y轴：垂直位置 -->
                            <TextBlock Grid.Row="2" Text="垂直 (Y)" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,6,0,2"/>
                            <ListBox Grid.Row="3" Name="lstPosY" SelectionMode="Single"
                                     SelectionChanged="OnPosYSelectionChanged"
                                     PreviewMouseLeftButtonDown="OnPosYPreviewMouseDown"
                                     MaxHeight="120">
                                <ListBoxItem Content="上上"/>
                                <ListBoxItem Content="中上"/>
                                <ListBoxItem Content="上"/>
                                <ListBoxItem Content="平"/>
                                <ListBoxItem Content="下"/>
                                <ListBoxItem Content="中下"/>
                                <ListBoxItem Content="下下"/>
                            </ListBox>
                        </Grid>
                    </GroupBox>

                    <!-- 方位 -->
                    <GroupBox Grid.Row="0" Grid.Column="2" Header="方位" Margin="2,0,2,0">
                        <ListBox Name="lstPose" SelectionMode="Single" SelectionChanged="OnPoseSelectionChanged"/>
                    </GroupBox>

                    <!-- 服装 -->
                    <GroupBox Grid.Row="0" Grid.Column="3" Header="服装" Margin="2,0,2,0">
                        <ListBox Name="lstDress" SelectionMode="Single" SelectionChanged="OnDressFaceSelectionChanged"/>
                    </GroupBox>

                    <!-- 表情 -->
                    <GroupBox Grid.Row="0" Grid.Column="4" Header="表情" Margin="2,0,0,0">
                        <ListBox Name="lstFace" SelectionMode="Single" SelectionChanged="OnDressFaceSelectionChanged"/>
                    </GroupBox>

                    <!-- 清除位置按钮（位于位置层级列下方） -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Name="btnClearPosX" Content="清除水平" Width="70" Height="24"
                                Click="OnClearPosXClick"/>
                        <Button Name="btnClearPosY" Content="清除垂直" Width="70" Height="24" Margin="4,0,0,0"
                                Click="OnClearPosYClick"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 元素选项卡 -->
            <TabItem Header="元素">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左列：背景图片 -->
                    <GroupBox Grid.Column="0" Header="背景图片" Margin="0,0,4,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- 搜索框 -->
                            <TextBox Grid.Row="0" Name="txtBgSearch" Text="搜索背景..." Margin="2" 
                                     TextChanged="OnBgSearchTextChanged" Foreground="Gray" GotFocus="OnBgSearchGotFocus" LostFocus="OnBgSearchLostFocus"/>
                            
                            <!-- 背景列表 -->
                            <ListBox Grid.Row="1" Name="lstBackground" SelectionMode="Single" 
                                     SelectionChanged="OnBackgroundSelectionChanged"/>
                            
                            <!-- 清除按钮 -->
                            <Button Grid.Row="2" Name="btnClearBg" Content="清除背景" Width="100" Height="26" 
                                    Margin="2,4,2,2" Click="OnClearBackgroundClick"/>
                        </Grid>
                    </GroupBox>

                    <!-- 右列：背景音乐(BGM) -->
                    <GroupBox Grid.Column="1" Header="背景音乐(BGM)" Margin="4,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- 搜索框 -->
                            <TextBox Grid.Row="0" Name="txtBgmSearch" Text="搜索BGM..." Margin="2" 
                                     TextChanged="OnBgmSearchTextChanged" Foreground="Gray" GotFocus="OnBgmSearchGotFocus" LostFocus="OnBgmSearchLostFocus"/>
                            
                            <!-- BGM列表 -->
                            <ListBox Grid.Row="1" Name="lstBgm" SelectionMode="Single" 
                                     SelectionChanged="OnBgmSelectionChanged"/>
                            
                            <!-- 控制按钮 -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,4,2,2" HorizontalAlignment="Left">
                                <Button Name="btnStopBgm" Content="停止" Width="60" Height="24" Margin="0,0,4,0" Click="OnStopBgmClick"/>
                                <Button Name="btnPauseBgm" Content="暂停" Width="60" Height="24" Margin="0,0,4,0" Click="OnPauseBgmClick"/>
                                <Button Name="btnResumeBgm" Content="继续" Width="60" Height="24" Click="OnResumeBgmClick"/>
                            </StackPanel>
                            
                            <!-- 音量控制 -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="2,2,2,2" VerticalAlignment="Center">
                                <TextBlock Text="音量:" Width="35" VerticalAlignment="Center"/>
                                <Slider Name="sldBgmVolume" Width="150" Minimum="0" Maximum="1" Value="0.8" 
                                        SmallChange="0.01" LargeChange="0.1" TickFrequency="0.1"
                                        ValueChanged="OnBgmVolumeChanged"/>
                                <TextBlock Name="txtBgmVolume" Text="80%" Width="40" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
